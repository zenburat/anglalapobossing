local noclipConn2     = nil
local noclipCharConn  = nil

local function setNoclipParts(char, state)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
            part.CanTouch   = not state
        end
    end
end

Settings:Connect("Noclip", function(on)
    if noclipConn2    then noclipConn2:Disconnect();    noclipConn2    = nil end
    if noclipCharConn then noclipCharConn:Disconnect(); noclipCharConn = nil end

    if on then
        noclipConn2 = RunService.Stepped:Connect(function()
            local char = player.Character
            if not char then return end
            setNoclipParts(char, true)
        end)

        noclipCharConn = player.CharacterAdded:Connect(function(char)
            if not Settings:Get("Noclip") then return end
            task.wait(0.1)
            setNoclipParts(char, true)
            char.DescendantAdded:Connect(function(d)
                if d:IsA("BasePart") and Settings:Get("Noclip") then
                    d.CanCollide = false
                    d.CanTouch   = false
                end
            end)
        end)
    else
        local char = player.Character
        if char then setNoclipParts(char, false) end
    end
end)

