--------------------------------------------------------------------
-- SETTINGS BUS (REWRITTEN — reliable fire on set + connect)
--------------------------------------------------------------------
local Settings = { Values = {}, Listeners = {} }

function Settings:Set(id, value)
    local old = self.Values[id]
    self.Values[id] = value
    if old == value then
        -- still notify once on first registration, but skip dupes
    end
    for _, fn in ipairs(self.Listeners[id] or {}) do
        task.spawn(function()
            local ok, err = pcall(fn, value, old)
            if not ok then warn("[Valkadia] listener error on " .. id .. ": " .. tostring(err)) end
        end)
    end
end

function Settings:Get(id)
    return self.Values[id]
end

-- Connect fires immediately with current value, then on every change
function Settings:Connect(id, fn)
    self.Listeners[id] = self.Listeners[id] or {}
    table.insert(self.Listeners[id], fn)
    task.spawn(function()
        local ok, err = pcall(fn, self.Values[id], nil)
        if not ok then warn("[Valkadia] initial connect error on " .. id .. ": " .. tostring(err)) end
    end)
end

