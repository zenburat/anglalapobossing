local noRecoilConn    = nil
local basePitch       = nil
local lastShotTime    = 0

Settings:Connect("NoRecoil", function(on)
    if noRecoilConn then noRecoilConn:Disconnect(); noRecoilConn = nil end
    basePitch = nil

    if not on then return end

    noRecoilConn = RunService.RenderStepped:Connect(function(dt)
        if not Settings:Get("NoRecoil") then return end

        local cur               = camera.CFrame
        local pitch, yaw, roll  = cur:ToOrientation()

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            basePitch = pitch
        end

        if basePitch == nil then basePitch = pitch end

        local drift = pitch - basePitch
        if math.abs(drift) > 0.001 then
            local corrected = basePitch + drift * 0.05
            camera.CFrame   = CFrame.new(cur.Position) * CFrame.fromOrientation(corrected, yaw, roll)
        end

        local interval = 60 / fireRate
        local now      = tick()
        if now - lastShotTime >= interval then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                lastShotTime = now
            end
        end
    end)
end)

