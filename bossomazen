local espObjects = {}

local function getESP(p)
    if not espObjects[p] then
        local e = {
            box    = Drawing.new("Square"),
            name   = Drawing.new("Text"),
            health = Drawing.new("Text"),
            tracer = Drawing.new("Line"),
        }
        e.box.Filled       = false
        e.box.Thickness    = 1.5
        e.name.Size        = 13
        e.name.Color       = Color3.fromRGB(255, 255, 255)
        e.name.Outline     = true
        e.name.Center      = true
        e.health.Size      = 11
        e.health.Color     = Color3.fromRGB(100, 255, 100)
        e.health.Outline   = true
        e.health.Center    = true
        e.tracer.Thickness = 1
        espObjects[p]      = e
    end
    return espObjects[p]
end

local function hideESP(e)
    for _, d in pairs(e) do d.Visible = false end
end

local function clearESP(p)
    if espObjects[p] then
        for _, d in pairs(espObjects[p]) do d:Remove() end
        espObjects[p] = nil
    end
end

Players.PlayerRemoving:Connect(clearESP)

RunService.RenderStepped:Connect(function()
    if not Settings:Get("ESP") then
        for _, e in pairs(espObjects) do hideESP(e) end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local e    = getESP(p)
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if not char or not hum or not root or not head or hum.Health <= 0 then
            hideESP(e); continue
        end
        if Settings:Get("TeamCheck") and p.Team ~= nil and p.Team == player.Team then
            hideESP(e); continue
        end

        local topWorld    = head.Position + Vector3.new(0, head.Size.Y / 2 + 0.1, 0)
        local bottomWorld = root.Position - Vector3.new(0, 3.1, 0)

        local topScr,    topOn    = camera:WorldToViewportPoint(topWorld)
        local bottomScr, bottomOn = camera:WorldToViewportPoint(bottomWorld)

        if not topOn then hideESP(e); continue end

        local boxH = math.abs(topScr.Y - bottomScr.Y)
        local boxW = boxH * 0.5
        local boxX = topScr.X - boxW / 2
        local boxY = topScr.Y

        local vis   = isVisible(camera.CFrame.Position, root.Position)
        local color = vis and THEME.ESP or Color3.fromRGB(255, 165, 0)

        e.box.Visible  = true
        e.box.Size     = Vector2.new(boxW, boxH)
        e.box.Position = Vector2.new(boxX, boxY)
        e.box.Color    = color

        e.name.Visible  = true
        e.name.Text     = p.DisplayName
        e.name.Position = Vector2.new(topScr.X, boxY - 16)

        local hp = math.floor(hum.Health)
        e.health.Visible  = true
        e.health.Text     = tostring(hp) .. " HP"
        e.health.Position = Vector2.new(topScr.X, bottomScr.Y + 2)

        e.tracer.Visible = true
        e.tracer.From    = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
        e.tracer.To      = Vector2.new(topScr.X, topScr.Y)
        e.tracer.Color   = color
    end
end)

